{
  "expo": {
    "name": "InsightFlow",
    "slug": "insight-flow-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070b14",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "br.com.insightflow.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#070b14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "scheme": "insightflow",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#070b14"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#3aa0ff"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d071469c-ef74-45d8-a681-f4e78b7f5572"
      }
    },
    "owner": "brngstzz",
    "updates": {
      "url": "https://u.expo.dev/d071469c-ef74-45d8-a681-f4e78b7f5572",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
